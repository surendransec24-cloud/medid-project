# Fill in at least ONE channel. Never commit your real .env file.
PORT=3000
# Telegram (easiest, free): bot token from @BotFather; chat ids comma-separated
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
# ntfy push (free, no account): contacts install the ntfy app and subscribe to this topic
NTFY_TOPIC=
# Twilio SMS (trial can only text verified numbers)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
